# 构建产物
/codearts2api
/codearts2api.exe
*.exe

# 本地开发用的数据目录（含 STS 凭据 / 日志 / 构建产物，绝不入库）
/data/

# 运行期状态（含 STS 凭据与 refresh_token，绝不入库）
codearts2api-data.json
codearts2api-data.json.tmp
codearts-session.json
codearts-session.json.tmp
*.codearts2api.bak
*.codearts2api.tmp

# SearXNG 的运行时配置（首次启动自动生成，里面带 secret_key，绝不入库）
/searxng/

# 本地临时文件
/port.txt
/sid.txt

# 逆向中间产物
.recon/
__pycache__/
*.pyc
*.pyo

# Python 工具链缓存（tools/ 下的脚本用过 ruff / pytest）
.ruff_cache/
.pytest_cache/
.mypy_cache/
